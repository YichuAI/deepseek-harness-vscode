{
  "name": "harness-connector-deepseek",
  "displayName": "DeepSeek Harness Connector",
  "description": "Native VS Code client for DeepSeek Harness. Connect to your existing local Harness instance and continue the same workspaces and sessions directly inside VS Code.",
  "version": "0.0.5",
  "publisher": "lucasliang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liangwythu/deepseek-harness-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "agent",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseek-harness",
          "title": "DeepSeek Harness",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "deepseek-harness": [
        {
          "type": "webview",
          "id": "deepseekHarness.sessionView",
          "name": "Session",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "deepseekHarness.connect",
        "title": "DeepSeek Harness: Connect",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.disconnect",
        "title": "DeepSeek Harness: Disconnect",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.setSessionToken",
        "title": "DeepSeek Harness: Set Session Token from Launch URL",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.clearSessionToken",
        "title": "DeepSeek Harness: Clear Stored Session",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.openWebUI",
        "title": "DeepSeek Harness: Open Web UI",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.showLogs",
        "title": "DeepSeek Harness: Show Logs",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.newSession",
        "title": "DeepSeek Harness: New Session",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.refreshSessions",
        "title": "DeepSeek Harness: Refresh Sessions",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.openInSecondarySideBar",
        "title": "DeepSeek Harness: Move to Right Side Bar",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.addFileToChat",
        "title": "Add to Harness Chat",
        "category": "DeepSeek Harness"
      },
      {
        "command": "deepseekHarness.sendSelectionToChat",
        "title": "Send Selection to Harness",
        "category": "DeepSeek Harness"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deepseekHarness.setSessionToken",
          "when": "view == deepseekHarness.sessionView",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "deepseekHarness.addFileToChat",
          "group": "deepseek-harness"
        }
      ],
      "editor/context": [
        {
          "command": "deepseekHarness.sendSelectionToChat",
          "when": "editorHasSelection",
          "group": "deepseek-harness"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "deepseekHarness.host": {
          "type": "string",
          "default": "127.0.0.1",
          "markdownDescription": "DeepSeek Harness host. **v0.0.x only allows `127.0.0.1` or `localhost` (security boundary).** Any other value is refused."
        },
        "deepseekHarness.port": {
          "type": "number",
          "default": 3080,
          "markdownDescription": "Port of the local `dsh web` instance. The default `dsh web` port is `3080`."
        },
        "deepseekHarness.showSystemMessages": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show plugin-injected system messages (e.g. `@deepseek-ai/dsh-system-prompt` runtime context, approval-policy notices). Hidden by default to reduce noise."
        },
        "deepseekHarness.autoSession": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Mint the browser-session cookie locally from `$DSH_HOME/.credentials.yaml` so no launch URL has to be pasted. Disable to require the sanctioned token exchange every time. See the README's 'How the session is obtained' for the security reasoning."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "gen-icon": "tsx scripts/gen-icon.ts",
    "integration-test": "tsx scripts/integration-test.ts",
    "protocol-test": "tsx scripts/protocol-test.ts",
    "protocol-probe": "tsx scripts/protocol-probe.ts",
    "package": "vsce package --no-dependencies",
    "deploy": "npm run build && vsce package --no-dependencies --out dist/harness-connector-deepseek.vsix && code --install-extension dist/harness-connector-deepseek.vsix --force",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@types/potrace": "^2.1.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "markdown-it": "^15.0.0",
    "potrace": "^2.1.8",
    "sharp": "^0.35.3",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  },
  "allowScripts": {},
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
